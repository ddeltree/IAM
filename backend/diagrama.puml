@startuml
skinparam class {
  BackgroundColor<<enum>> LightBlue
  BackgroundColor<<interface>> LightGreen
}

' =====================================================================
' NÚCLEO — genérico, não conhece "turma", "post" nem "professor".
' Modelado a partir do IAM da AWS: principais (usuários e grupos) com
' políticas, e uma decisão em que a negação explícita vence a concessão.
' =====================================================================
namespace poo.iam {

  interface Action <<interface>> {
    +name(): String
  }

  interface ResourceType <<interface>> {
    +name(): String
  }

  enum PrincipalResource <<enum>> {
    USUARIO
    GRUPO
  }

  enum Effect <<enum>> {
    ALLOW
    DENY
  }

  class Permission {
    -action: Action
    -resourceType: ResourceType
    +getAction(): Action
    +getResourceType(): ResourceType
    +equals(o: Object): boolean
    +hashCode(): int
  }

  interface Resource <<interface>> {
    +getType(): ResourceType
    +getId(): String
    +getPai(): Resource
  }

  class RequestContext {
    -valores: Map<String, List<String>>
    +get(chave: String): List<String>
    +has(chave: String): boolean
  }

  interface AttributeProvider <<interface>> {
    +tipo(): ResourceType
    +atributosDe(r: Resource): Map<String, List<String>>
  }

  class ContextResolver {
    -provedores: Map<ResourceType, AttributeProvider>
    +registrar(p: AttributeProvider): void
    +resolver(principal: User, alvo: Resource, extra: Object...): RequestContext
  }

  class Decisao {
    +tipo(): Tipo
    +decisiva(): Statement
    +origem(): String
    +permitido(): boolean
  }

  class PolicyJson <<utility>> {
    +deUsuario(u: User): Map {static}
    +deGrupo(g: Group): Map {static}
  }

  interface PrincipalDirectory <<interface>> {
    +usuarios(): Collection<User>
    +grupos(): Collection<Group>
  }

  class Statement {
    -sid: String
    -effect: Effect
    -permission: Permission
    -condition: Condition
    +allow(p: Permission): Statement {static}
    +allow(p: Permission, c: PermissionCondition): Statement {static}
    +deny(p: Permission): Statement {static}
    +deny(p: Permission, c: PermissionCondition): Statement {static}
    +aplica(p: Permission, user: User, r: Resource, ctx: Object...): boolean
    +falaSobre(p: Permission): boolean
  }

  class PermissionHolder {
    -statements: Set<Statement>
    +grant(p: Permission): boolean
    +grant(p: Permission, c: PermissionCondition): boolean
    +revoke(p: Permission): boolean
    +deny(p: Permission): boolean
    +deny(p: Permission, c: PermissionCondition): boolean
    +allow(p: Permission): boolean
    +permite(p, user, resource, ctx): boolean
    +nega(p, user, resource, ctx): boolean
    +getPermissions(): Set<Permission>
    +getDeniedPermissions(): Set<Permission>
    +clear(): void
  }

  class AccessResolver <<utility>> {
    +isAllowed(user: User, p: Permission, r: Resource, ctx: Object...): boolean {static}
    +avaliar(user, p, r, ctx...): Decisao {static}
  }

  class User implements Resource {
    -proximoId: long {static}
    -id: String {readOnly}
    -name: String
    -groups: Set<Group>
    -policy: PermissionHolder
    +grantPermission(p: Permission): boolean
    +grantPermission(p: Permission, c: PermissionCondition): boolean
    +revokePermission(p: Permission): boolean
    +denyPermission(p: Permission): boolean
    +denyPermission(p: Permission, c: PermissionCondition): boolean
    +allowPermission(p: Permission): boolean
    ~getPolicy(): PermissionHolder
    +getGroups(): Set<Group>
    +getType(): ResourceType
  }

  class Group {
    -name: String
    -users: Set<User>
    -policy: PermissionHolder
    +grantPermission(p: Permission): boolean
    +grantPermission(p: Permission, c: PermissionCondition): boolean
    +denyPermission(p: Permission): boolean
    +allowPermission(p: Permission): boolean
    ~getPolicy(): PermissionHolder
  }

  class MembershipManager <<utility>> {
    +link(user: User, group: Group): void {static}
    +unlink(user: User, group: Group): void {static}
  }
}

' =====================================================================
' A CONDIÇÃO COMO DADO — Composite + Visitor. É por ser árvore, e não
' lambda, que a política pode ser impressa, explicada e consultada.
' =====================================================================
namespace poo.iam.condition {

  interface Condition <<interface>> {
    +avaliar(ctx: RequestContext): boolean
    +chaves(): Set<String>
    +accept(v: ConditionVisitor): R
  }

  interface ConditionVisitor <<interface>> {
    +visitarSempre() / visitarComparacao()
    +visitarTodasAs() / visitarAlgumaDas()
    +visitarNegacao() / visitarOpaca()
  }

  class Comparacao {
    -operador: ConditionOperator
    -chave: String
    -valores: List<String>
  }
  class TodasAs
  class AlgumaDas
  class Negacao
  class Sempre
  class CondicaoOpaca {
    -legado: PermissionCondition
  }

  interface ConditionOperator <<interface>> {
    +name(): String
    +testar(doContexto, daPolitica): boolean
  }

  class Operadores <<utility>> {
    +IGUAL / DIFERENTE / PARECIDO {static}
    +BOOLEANO / NULO {static}
    +paraAlgumValor(base): ConditionOperator {static}
  }

  class ConditionJson <<utility>> {
    +escrever(c: Condition): Object {static}
    +ler(node: JsonNode): Condition {static}
  }
}

' =====================================================================
' AS CONSULTAS — o que o motor passou a saber responder quando a
' condição virou dado.
' =====================================================================
namespace poo.iam.query {

  class PolicyQuery {
    +quemPode(p, recurso): Resultado
    +quemPodeVarrendo(p, recurso): List<User>
    +ondePosso(principal, p): ResourceConstraint
    +filtrar(principal, p, candidatos): List
  }

  class PrincipalConstraintExtractor {
    ' fixa o recurso, deixa o principal em aberto
    +extrair(c: Condition, doRecurso): PrincipalConstraint {static}
  }

  interface ResourceConstraint <<interface>> {
    ' fixa o principal, deixa o recurso em aberto
    +accept(v: ConstraintVisitor): R
  }

  class ResourceConstraintExtractor
  class PredicateRenderer
  class SqlWhereRenderer
  interface SqlMapping <<interface>>
}

' =====================================================================
' APLICAÇÃO — o classroom. Declara o vocabulário concreto e escreve a
' política padrão. Depende do núcleo; o núcleo não depende dela.
' =====================================================================
namespace poo.classroom.iam {

  enum ClassroomAction <<enum>> {
    LISTAR_TURMAS
    VER_TURMA
    LISTAR_ATIVIDADES
    LISTAR_POSTS
    LISTAR_COMENTARIOS
    LISTAR_PARTICIPANTES
    LISTAR_USUARIOS
    VER_PERFIL
    CRIAR_TURMA
    CRIAR_ATIVIDADE
    CRIAR_POST
    CRIAR_COMENTARIO
    CRIAR_PROFESSOR
    CRIAR_ALUNO
    EDITAR_TURMA
    EDITAR_ATIVIDADE
    EDITAR_POST
    EDITAR_COMENTARIO
    EDITAR_USUARIO
    EXCLUIR_TURMA
    EXCLUIR_ATIVIDADE
    EXCLUIR_POST
    EXCLUIR_COMENTARIO
    EXCLUIR_USUARIO
    MATRICULAR_ALUNO
    DESMATRICULAR_ALUNO
  }

  enum ClassroomResource <<enum>> {
    TURMA
    POST
    ATIVIDADE
    COMENTARIO
  }

  class ClassroomConditions <<utility>> {
    +PROFESSOR_RESPONSAVEL: Condition {static}
    +ALUNO_MATRICULADO: Condition {static}
    +PARTICIPANTE: Condition {static}
    +AUTOR: Condition {static}
    +PROPRIO_USUARIO: Condition {static}
  }

  class ClassroomAttributes <<utility>> {
    ' lê a chave de dentro do objeto
    +registrarTodos(r: ContextResolver): void {static}
  }

  class ClassroomSqlMapping {
    ' escreve a mesma chave em SQL
    +igual(chave, valor): String
    +contem(chave, valor): String
  }

  class PermissoesEfetivas <<utility>> {
    +sobre(user: User, r: Resource): Map<String, Boolean> {static}
    +globais(user: User): Map<String, Boolean> {static}
  }

  enum ClassroomPermission <<enum>> {
    ' catálogo (ação, tipo de recurso) — sem condição
    -permission: Permission
    +isAllowed(user: User, resource: Resource, ctx: Object...): boolean
    +isAllowed(user: User): boolean
    +get(): Permission
  }

  class SecurityContext {
    -instance: SecurityContext {static}
    -admin: User
    -alunos: Group
    -professores: Group
    +getInstance(): SecurityContext {static}
    -configurarAdmin(): void
    -configurarProfessores(): void
    -configurarAlunos(): void
    +isProfessor(user: User): boolean
    +isAluno(user: User): boolean
    +isAdmin(user: User): boolean
    +reset(): void
  }
}

namespace poo.classroom {
  class Turma implements poo.iam.Resource
  class Atividade implements poo.iam.Resource
  class Post implements poo.iam.Resource
  class Comentario implements poo.iam.Resource
}

' --- núcleo ---
User "1" *-- "1" PermissionHolder : política inline
Group "1" *-- "1" PermissionHolder : política do grupo
User "*" -- "*" Group
MembershipManager ..> User
MembershipManager ..> Group

PermissionHolder "1" o-- "*" Statement
Statement --> Effect
Statement --> Permission
Statement --> Condition
AccessResolver ..> Decisao
AccessResolver ..> ContextResolver
ContextResolver ..> AttributeProvider
ContextResolver ..> RequestContext
Condition ..> RequestContext
Comparacao ..|> Condition
TodasAs ..|> Condition
AlgumaDas ..|> Condition
Negacao ..|> Condition
Sempre ..|> Condition
CondicaoOpaca ..|> Condition
Comparacao --> ConditionOperator
ConditionJson ..> ConditionVisitor
PolicyQuery ..> PrincipalDirectory
PolicyQuery ..> PrincipalConstraintExtractor
PolicyQuery ..> ResourceConstraintExtractor
PredicateRenderer ..> ResourceConstraint
SqlWhereRenderer ..> ResourceConstraint
SqlWhereRenderer --> SqlMapping
Permission --> Action
Permission --> ResourceType
PrincipalResource ..|> ResourceType
AccessResolver ..> User
AccessResolver ..> Group
AccessResolver ..> Statement

' --- aplicação -> núcleo (a seta nunca aponta de volta) ---
ClassroomAction ..|> Action
ClassroomResource ..|> ResourceType
ClassroomPermission --> Permission
ClassroomPermission ..> AccessResolver
ClassroomConditions ..> Condition
ClassroomAttributes ..|> AttributeProvider
ClassroomSqlMapping ..|> SqlMapping
PermissoesEfetivas ..> ClassroomPermission
SecurityContext "1" *-- "1" User : admin
SecurityContext "1" *-- "2" Group : alunos, professores
SecurityContext ..> ClassroomPermission
SecurityContext ..> ClassroomConditions

note bottom of SecurityContext
  A condição mora na concessão, não na ação.
  É o que permite dar a mesma permissão com
  restrições diferentes a cada grupo:

  admin.grant(EDITAR_POST)
  professores.grant(EDITAR_POST, AUTOR)
end note

note bottom of SqlWhereRenderer
  Um vocabulário de chaves, dois sentidos:
  ClassroomAttributes  lê  turma:professorId
    de dentro de uma Turma;
  ClassroomSqlMapping  escreve a mesma chave
    como turma.professor_id = ?

  O mesmo ResourceConstraint vira predicado
  em memória ou cláusula WHERE — sem que a
  política mude.
end note

note top of AccessResolver
  Ordem de decisão, como na AWS:
  negação explícita > concessão > negar por padrão.
  Vale para a política inline e a dos grupos.
end note

@enduml
