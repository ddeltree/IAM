@startuml
skinparam class {
  BackgroundColor<<enum>> LightBlue
  BackgroundColor<<interface>> LightGreen
  BackgroundColor<<spi>> Wheat
}
skinparam packageStyle rectangle

' =====================================================================
' Dois módulos Maven. iam-core não tem dependência de compilação
' nenhuma — nem do classroom, nem de Javalin, nem de Jackson —, e é o
' compilador que garante isso, não disciplina de quem escreve.
'
' Modelado a partir do IAM da AWS: principais com políticas, cláusulas
' de quatro campos, e uma decisão em que a negação explícita vence.
' =====================================================================

package "iam-core" #FDFDFD {

' ---------------------------------------------------------------------
' O vocabulário. Action e ResourceType são interfaces, e não enums
' fechados: cada aplicação declara as próprias, como a AWS usa nomes
' de texto ("s3:GetObject") em vez de uma lista dentro do IAM.
' ---------------------------------------------------------------------
namespace poo.iam {

  interface Action <<interface>> {
    +name(): String
  }

  interface ResourceType <<interface>> {
    +name(): String
  }

  interface Resource <<interface>> {
    +getType(): ResourceType
    +getId(): String
    +getPai(): Resource
  }

  enum PrincipalResource <<enum>> {
    USUARIO
    GRUPO
    PAPEL
  }

  enum IamAction <<enum>> {
    ASSUMIR_PAPEL
  }

  enum Effect <<enum>> {
    ALLOW
    DENY
  }

  class Permission {
    -action: Action
    -resourceType: ResourceType
    .. compara por NOME, não por objeto ..
    +equals(o: Object): boolean
  }

  ' --- padrões: é o que faz "pode tudo" caber em uma cláusula -------
  class ActionPattern {
    -padrao: String
    +casa(a: Action): boolean
    +exato(): boolean
  }

  class ResourcePattern {
    -tipo: String
    -id: String
    +casa(r: Resource): boolean
    +casaTipo(t: ResourceType): boolean
    +idExato(): boolean
  }

  class Curinga {
    {static} +casa(valor: String, padrao: String): boolean
  }

  ' --- a cláusula: os quatro campos da AWS -------------------------
  class Statement {
    -effect: Effect
    -action: ActionPattern
    -resource: ResourcePattern
    -condition: Condition
    -sid: String
    +aplica(p: Permission, ctx: RequestContext): boolean
    +falaSobre(p: Permission): boolean
    +comSid(sid: String): Statement
  }

  class Policy {
    -nome: String
    -statements: Set<Statement>
    .. imutável: anexar a dez não abre dez caminhos para alterar ..
  }

  class PermissionHolder {
    -statements: Set<Statement>
    -anexadas: List<Policy>
    +anexar(p: Policy): boolean
    +getStatements(): Set<Statement>
  }

  ' --- quem pede ---------------------------------------------------
  interface Principal <<interface>> {
    +getId(): String
    +getName(): String
    +getStatements(): Set<Statement>
    +herdaDe(): Collection<Principal>
    +chavesDeContexto(): Map<String, List<String>>
  }

  class User {
    -id: String
    -groups: Set<Group>
    +grantPermission(p: Permission, c: Condition): boolean
    +anexar(p: Policy): boolean
  }

  class Group {
    -id: String
    -users: Set<User>
  }

  class Role {
    -confianca: Set<Statement>
    +confiaEm(quem: Condition): Role
    +getConfianca(): Policy
  }

  class Session {
    -papel: Role
    -origem: Principal
    .. principal:id vira o id da SESSÃO ..
  }

  class SessionBroker {
    +podeAssumir(quem: Principal, papel: Role): Decisao
    +assumir(quem: Principal, papel: Role): Session
  }

  ' --- o contexto sobre o qual as condições decidem -----------------
  class RequestContext {
    -valores: Map<String, List<String>>
    +get(chave: String): List<String>
  }

  class ContextResolver {
    -provedores: Map<ResourceType, AttributeProvider>
    -relogio: Clock
    +resolver(p: Principal, alvo: Resource, chaves: Map): RequestContext
  }

  ' --- o motor -----------------------------------------------------
  class AuthorizationEngine {
    -contexto: ContextResolver
    -politicasDeRecurso: ResourcePolicyProvider
    +isAllowed(p, perm, r): boolean
    +avaliar(p, perm, r): Decisao
    .. deny explícito > allow > negar por padrão ..
  }

  class Decisao {
    +getTipo(): Tipo
    +getDecisiva(): Statement
    +getOrigem(): String
    +getMotivo(): String
  }

  class EffectivePermissions {
    +globais(p: Principal): Map<String, Boolean>
    +sobre(p: Principal, r: Resource): Map<String, Boolean>
    +explicadas(p, r): Map<String, Decisao>
  }

  class Iam {
    +motor(): AuthorizationEngine
    +consultas(): PolicyQuery
    +efetivas(): EffectivePermissions
    +papeis(): SessionBroker
  }

  class IamFactory {
    +atributos(...): IamFactory
    +catalogo(c: ActionCatalog): IamFactory
    +principais(d: PrincipalDirectory): IamFactory
    +politicasDeRecurso(p): IamFactory
    +construir(): Iam
  }
}

' ---------------------------------------------------------------------
' O CONTRATO DE INTEGRAÇÃO. Tudo o que uma aplicação precisa
' implementar está aqui, e quase nenhum sistema precisa das sete.
' ---------------------------------------------------------------------
namespace poo.iam.spi {

  interface AttributeProvider <<spi>> {
    +tipo(): ResourceType
    +atributosDe(r: Resource): Map<String, List<String>>
  }

  interface ActionCatalog <<spi>> {
    +todas(): Collection<Permission>
    +semAlvo(): Collection<Permission>
  }

  interface PrincipalDirectory <<spi>> {
    +usuarios(): Collection<User>
    +grupos(): Collection<Group>
    +papeis(): Collection<Role>
  }

  interface ResourcePolicyProvider <<spi>> {
    +politicaDe(r: Resource): Policy
    +comPoliticaPropria(t: ResourceType): Collection<Resource>
  }

  interface SqlMapping <<spi>> {
    +igual(chave, valor): String
    +contem(chave, valor): String
    +compara(chave, op, valor): String
  }

  interface PolicyListener <<spi>> {
    +politicaMudou(alvo, mudanca, permission): void
  }
}

' ---------------------------------------------------------------------
' A CONDIÇÃO COMO DADO. Composite + Visitor: enquanto era lambda dava
' para executá-la e nada mais; sendo árvore, também se lê.
' ---------------------------------------------------------------------
namespace poo.iam.condition {

  interface Condition <<interface>> {
    +avaliar(ctx: RequestContext): boolean
    +chaves(): Set<String>
    +accept(v: ConditionVisitor): R
  }

  class Comparacao {
    -operador: ConditionOperator
    -chave: String
    -valores: List<String>
    .. expande ${principal:id} ..
  }

  class TodasAs
  class AlgumaDas
  class Negacao
  class Sempre
  class Nunca
  class CondicaoOpaca {
    .. saída de emergência: opaca às consultas ..
  }

  interface ConditionVisitor <<interface>> {
    +visitarComparacao(c): R
    +visitarTodasAs(t): R
    +visitarAlgumaDas(a): R
    +visitarNegacao(n): R
    +visitarSempre(s): R
    +visitarNunca(n): R
    +visitarOpaca(o): R
  }

  interface ConditionOperator <<interface>> {
    +name(): String
    +testar(doContexto, daPolitica): boolean
  }

  class Operadores {
    .. Igual, Diferente, Parecido, Booleano, Nulo ..
    .. Maior, Menor, DataDepois, DataAntes ..
    .. prefixos: ParaAlgumValor:, ParaTodoValor:, SeExistir: ..
  }

  class OperatorRegistry {
    +get(nome: String): ConditionOperator
    +registrar(op: ConditionOperator): OperatorRegistry
  }
}

' ---------------------------------------------------------------------
' A POLÍTICA COMO DOCUMENTO, nos dois sentidos. Map/List/texto, sem
' escolher biblioteca de serialização por quem usa.
' ---------------------------------------------------------------------
namespace poo.iam.document {

  class PolicyDocument {
    {static} +escrever(p: Policy): Map
    {static} +ler(node: Object): Policy
    {static} +deUsuario(u: User): Map
  }

  class ConditionDocument {
    {static} +escrever(c: Condition): Object
    {static} +ler(node: Object): Condition
  }

  interface PolicyRepository <<interface>> {
    +porNome(nome: String): Policy
    {static} +deDocumento(doc: Object): PolicyRepository
  }
}

' ---------------------------------------------------------------------
' AS CONSULTAS. Regra que as torna seguras: a extração só escolhe
' candidatos; o motor avalia cada sobrevivente.
' ---------------------------------------------------------------------
namespace poo.iam.query {

  class PolicyQuery {
    +quemPode(perm, recurso): Resultado
    +quemPodeVarrendo(perm, recurso): List<User>
    +ondePosso(quem, perm): ResourceConstraint
    +filtrar(quem, perm, candidatos): List<T>
  }

  interface ResourceConstraint <<interface>> {
    .. Tudo | Nada | AtributoIgual | AtributoContem ..
    .. AtributoCompara | IdEm | Todas | Alguma ..
  }

  class PrincipalConstraint {
    .. fixa o recurso, deixa o principal aberto ..
  }

  interface ConstraintVisitor <<interface>>

  class PredicateRenderer {
    .. o filtro em memória ..
  }

  class SqlWhereRenderer {
    .. o mesmo filtro como WHERE ..
  }
}
}

package "classroom" #F5F5F5 {

namespace poo.classroom.iam {
  enum ClassroomAction <<enum>>
  enum ClassroomResource <<enum>>
  enum ClassroomPermission <<enum>> {
    {static} +CATALOGO: ActionCatalog
  }
  class ClassroomAttributes
  class ClassroomSqlMapping
  class ClassroomConditions
  class SecurityContext {
    .. carrega politica-padrao.json ..
    +iam(): Iam
  }
}

namespace poo.classroom {
  class Turma
  class Publicacao
  class Post
  class Atividade
  class Comentario
}

namespace poo.api {
  class Utils
  class IamMixins
  class TurmaController
  class PermissoesController
}
}

' ===================== relações do núcleo ============================
User ..|> Principal
User ..|> Resource
Group ..|> Principal
Group ..|> Resource
Role ..|> Principal
Role ..|> Resource
Session ..|> Principal
Session --> Role : exerce
Session --> Principal : origem

User *-- PermissionHolder
Group *-- PermissionHolder
PermissionHolder o-- Statement
PermissionHolder o-- Policy : anexadas
Policy o-- Statement
Statement *-- ActionPattern
Statement *-- ResourcePattern
Statement *-- Condition
ActionPattern ..> Curinga
ResourcePattern ..> Curinga

AuthorizationEngine ..> Principal : percorre o grafo
AuthorizationEngine ..> ContextResolver
AuthorizationEngine ..> ResourcePolicyProvider
AuthorizationEngine --> Decisao
SessionBroker ..> AuthorizationEngine : a confiança é\npolítica de recurso
ContextResolver o-- AttributeProvider
ContextResolver --> RequestContext
EffectivePermissions ..> ActionCatalog
Iam *-- AuthorizationEngine
Iam *-- PolicyQuery
Iam *-- EffectivePermissions
IamFactory --> Iam : constrói

Comparacao ..|> Condition
TodasAs ..|> Condition
AlgumaDas ..|> Condition
Negacao ..|> Condition
Sempre ..|> Condition
Nunca ..|> Condition
CondicaoOpaca ..|> Condition
Comparacao --> ConditionOperator
OperatorRegistry o-- ConditionOperator

PolicyDocument ..> ConditionDocument
PolicyDocument --> Policy
ConditionDocument ..|> ConditionVisitor
PolicyRepository --> Policy

PolicyQuery ..> AuthorizationEngine : confirma cada\nsobrevivente
PolicyQuery ..> PrincipalDirectory
PolicyQuery --> ResourceConstraint
PredicateRenderer ..|> ConstraintVisitor
SqlWhereRenderer ..|> ConstraintVisitor
SqlWhereRenderer ..> SqlMapping

' ===================== o classroom adapta ============================
ClassroomAction ..|> Action
ClassroomResource ..|> ResourceType
ClassroomAttributes ..|> AttributeProvider
ClassroomSqlMapping ..|> SqlMapping
ClassroomPermission ..> ActionCatalog
SecurityContext --> Iam : monta e guarda
SecurityContext ..> PolicyRepository : carrega o documento
Turma ..|> Resource
Publicacao ..|> Resource
Comentario ..|> Resource
Post --|> Publicacao
Atividade --|> Publicacao
Utils ..> ClassroomPermission
IamMixins ..> Resource : esconde getPai() do JSON

note bottom of IamMixins
  As anotações do Jackson moram aqui, e não no núcleo.
  Anotação de quem serializa é detalhe de quem serializa —
  e com ela dentro, quem usasse o núcleo herdaria a
  escolha de biblioteca desta API.
end note

note bottom of PolicyQuery
  A extração de restrição só ENCOLHE o conjunto de
  candidatos; o motor avalia cada sobrevivente. Assim um
  erro no extrator custa desempenho, nunca acesso indevido.
end note

@enduml
